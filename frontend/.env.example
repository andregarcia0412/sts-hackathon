# Data source: "mock" (fictitious, default) | "static" (JSONs of backend-export-frontend) | "api" (real back-end)
VITE_DATA_SOURCE=mock
# Folder of the static export (spec 13), served by Vite in dev / bundled in the build.
# Absolute path: nested routes would break a relative one.
VITE_STATIC_API_DIR=/static-api
# Real back-end (spec 14 E2/E3)
VITE_API_URL=http://127.0.0.1:8000