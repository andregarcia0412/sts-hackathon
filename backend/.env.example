MONGODB_URI=mongodb://root:root@localhost:27017/?authSource=admin
MONGODB_DB=sts

# JWT (required). Use long random values (>= 32 bytes), e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-32-plus-bytes
JWT_REFRESH_SECRET=change-me-to-another-random-string-of-32-plus-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seed users created on startup: n = 1..5 is substituted into the pattern (required).
SEED_EMAIL_PATTERN=user{n}@sts.com
SEED_PASSWORD=senha12345

# ---------------------------------------------------------------- Ollama (models: change only here)
# Cloud (https://ollama.com) or local (http://localhost:11434).
OLLAMA_HOST=https://ollama.com
# Key from https://ollama.com/settings/keys. Required on the cloud and always for web_search/web_fetch.
OLLAMA_API_KEY=
# Default model of every role (cloud models: https://ollama.com/search?c=cloud).
OLLAMA_MODEL=
# Optional per-role overrides (empty = OLLAMA_MODEL):
OLLAMA_MODEL_EXTRACTION=   # extraction agent: file type + section/column mapping
OLLAMA_MODEL_DOC=          # document sub-agent of each criterion (-D rules)
OLLAMA_MODEL_SEARCH=       # web query planning and page dates
OLLAMA_MODEL_JUDGE=        # web rule judge, criterion state judge, contestation verdicts
OLLAMA_MODEL_REPORT=       # report (parecer) prose
OLLAMA_MODEL_CHAT=         # chatbot
OLLAMA_MAX_CONCURRENCY=4
OLLAMA_TIMEOUT_S=180
OLLAMA_RETRIES=2
# New attempts when the answer does not match the JSON schema (the error and expected fields are fed back).
OLLAMA_SCHEMA_RETRIES=2

# ---------------------------------------------------------------- Web search
# OpenAlex (literature): optional key raises the daily quota 10x.
OPENALEX_API_KEY=
# Needed for batch runs (benchmarks, the 20 cases): puts the searches in OpenAlex's "polite pool" (fewer 429s).
OPENALEX_MAILTO=
# Concurrent OpenAlex requests; a 429 waits for Retry-After and is retried up to OLLAMA_RETRIES times.
OPENALEX_MAX_CONCURRENCY=2
WEB_QUERIES_PER_FRONT=3
WEB_RESULTS_PER_QUERY=5
WEB_FETCH_PER_FRONT=6

# ---------------------------------------------------------------- Pipeline
# Analyses running at the same time (batch queue; respect API rate limits / GPU).
ANALYSIS_CONCURRENCY=2

# ---------------------------------------------------------------- State judge
# estado = the LLM picks the state label; questionario = the LLM answers closed questions with evidence and the
# decision table (catalog/questionario.yaml) turns the answers into the state, in code.
JUDGE_MODE=estado
# The criterion handbook (catalog/handbooks/*.md: pitfalls, when to use each state) in the judge's prompt.
JUDGE_HANDBOOKS=true
# Also give the handbook pitfalls to the document sub-agent (validate on the judge first: needs a full benchmark).
DOC_HANDBOOK_PITFALLS=false
# Coherence gate (score × state): off = no check; flag = only marks the contradiction;
# reask = marks and asks the judge once more with the contradiction spelled out.
# A strong score is >= HIGH (or <= LOW) with at least MIN_RULES rules with evidence.
COHERENCE_MODE=reask
COHERENCE_HIGH=75
COHERENCE_LOW=25
COHERENCE_MIN_RULES=4
# Consistency between criteria: a CRI/INC positive evidence on a source that NOV-D4/D5/D10 used as proof that the
# prior reference already provided the function leaves the score (kept in the graph, marked). Off until measured.
CONSISTENCY_NEUTRALIZE=false
# Also mark sources only by the containment wording of other NOV rules ("já fornecia", "anterior"...): noisy.
CONSISTENCY_USE_TEXT_MARKERS=false
# INC-D2 positive evidence quoting a registered question that already names the known solution (CHK-PERGUNTA)
# counts as negative. Off until CHK-PERGUNTA is checked by hand outside the answer key (PRJ21-40).
CONSISTENCY_INC_D2=false
# Rows of each large table sent to a sub-agent prompt (the rest is noted as truncated).
PROMPT_MAX_TABLE_ROWS=300
# Root of the hackathon package (the folder with 01_projetos/ and historicos_classificados.csv).
# POST /batches and POST /benchmarks only accept paths inside it; benchmarks default to its layout.
# Optional leitura_preliminar.csv there = the team's NOT official reading of PRJ21-40 for the benchmark.
PACKAGE_DIR=
# Normative PDFs for the chatbot (BM25). Indexed in the background on the first start.
NORMS_DIR=data/normas
NORMS_AUTO_INGEST=true

# Front-end origins, comma separated.
CORS_ORIGINS=http://localhost:5173
