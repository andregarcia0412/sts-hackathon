# Ollama: cloud (https://ollama.com) ou local (http://localhost:11434)
OLLAMA_HOST=https://ollama.com
# Chave em https://ollama.com/settings/keys. Obrigatória no cloud e para web_search/web_fetch (mesmo com chat local)
OLLAMA_API_KEY=
# Modelo padrão de todos os papéis (lista de modelos cloud: https://ollama.com/search?c=cloud)
OLLAMA_MODEL=
# Overrides opcionais por papel (vazio = OLLAMA_MODEL)
OLLAMA_MODEL_EXTRACTION=
OLLAMA_MODEL_SEARCH=
OLLAMA_MODEL_JUDGE=
OLLAMA_MAX_CONCURRENCY=4
OLLAMA_TIMEOUT_S=180

# OpenAlex (literatura): chave opcional, aumenta a cota diária em 10x
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# Origens do frontend, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Tamanho da busca de novidade
NOVELTY_QUERIES_PER_FRONT=3
NOVELTY_RESULTS_PER_QUERY=5
NOVELTY_FETCH_PER_FRONT=6
